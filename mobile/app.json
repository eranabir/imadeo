{
  "expo": {
    "name": "Imadeo",
    "slug": "imadeo",
    "scheme": "imadeo",
    "owner": "eranabir",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "ee399e99-7709-4421-bfc7-f773da4e2b2a"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.imadeo.mobile",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Imadeo connects to the server you own on your home network.",
        "NSBonjourServices": ["_imadeo._tcp"],
        "NSLocationWhenInUseUsageDescription": "Imadeo uses your location while the app is open to show photo places and choose the right server address for your Wi-Fi network. Your location is never sent anywhere.",
        "NSMotionUsageDescription": "Imadeo may use device motion while the app is open to support map orientation and media viewing. Motion data is never stored or shared."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "package": "app.imadeo.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Imadeo compares your photos against your own server so it knows which ones are not backed up yet.",
          "savePhotosPermission": "Imadeo saves photos you download from your server back to this phone.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-video",
      "expo-background-task",
      "@maplibre/maplibre-react-native",
      "expo-image",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Imadeo uses your location while the app is open to show photo places and choose the right server address for your Wi-Fi network. Your location is never sent anywhere."
        }
      ],
      "expo-router"
    ]
  }
}
