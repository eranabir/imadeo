{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the root so the emitted tree is dist/main.js, not dist/src/main.js.
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "prisma",
    "prisma.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
