# ---------------------------------------------------------------------------
# Imadeo configuration
# Copy to `.env` and edit before running `docker compose up`.
# ---------------------------------------------------------------------------

# --- Public HTTPS -----------------------------------------------------------
# A domain is required in production. Point it to this host, then forward TCP
# ports 80 and 443; Caddy obtains and renews the certificate automatically.
IMADEO_DOMAIN=photos.example.com
HTTPS_HTTP_PORT=80
HTTPS_HTTPS_PORT=443
IMADEO_ML_PORT=3003

# --- Storage ----------------------------------------------------------------
# Host path where originals, thumbnails and encoded video live.
UPLOAD_LOCATION=./data/library
# Host path for ML model weights (a few GB once warmed up).
MODEL_CACHE_LOCATION=./data/model-cache
# Host path for the postgres data directory.
DB_DATA_LOCATION=./data/postgres

# --- Database ---------------------------------------------------------------
DB_HOSTNAME=database
# Host port used only for local tooling (prisma migrate, psql). Containers always
# talk to postgres on 5432 over the compose network. Change this if you already
# run postgres on the host.
DB_PORT=5433
DB_USERNAME=imadeo
DB_PASSWORD=change-me-please
DB_DATABASE_NAME=imadeo

# --- Redis ------------------------------------------------------------------
REDIS_HOSTNAME=redis
# Host port for local tooling only; containers use 6379 internally.
REDIS_PORT=6380
REDIS_PASSWORD=

# --- Security ---------------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-bytes-of-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# Development only: issue access tokens with no expiry so you stay signed in
# while working. Ignored entirely when NODE_ENV=production — a token that never
# expires is valid forever if it leaks, so it cannot be enabled there.
DEV_PERSISTENT_SESSION=true
# Used to derive the key that encrypts locked-folder content keys.
# Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=replace-with-32-bytes-of-hex

# --- Email (album invites) --------------------------------------------------
# Optional. Without it invites still work: the person is added to the album and
# the UI shows a link (and temporary password for new accounts) to pass on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Imadeo <no-reply@imadeo.local>

# --- Sign in with Google ----------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
# Authorised redirect URI must be exactly:
#   <PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple -----------------------------------------------------
# developer.apple.com -> Certificates, Identifiers & Profiles
#   1. Create an App ID with "Sign in with Apple" enabled.
#   2. Create a Services ID — that identifier is APPLE_CLIENT_ID (NOT the bundle id).
#   3. Add the return URL: <PUBLIC_URL>/api/auth/oauth/apple/callback
#   4. Create a Key with "Sign in with Apple", download the .p8 once.
# Apple requires HTTPS for the return URL, so this cannot be tested on
# plain http://localhost — use a tunnel or your real domain.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the whole .p8 body on one line with \n between the lines.
APPLE_PRIVATE_KEY=

# Keep OAuth invitation-only. An administrator can still link Google or Apple
# to an existing account under Settings.
OAUTH_AUTO_REGISTER=false

# --- Server behaviour -------------------------------------------------------
LOG_LEVEL=log
# Must be the public HTTPS address in production.
PUBLIC_URL=https://photos.example.com
# Allow anyone to register. When false only admins can create users.
PUBLIC_REGISTRATION=false
# Days a trashed asset survives before permanent deletion.
TRASH_RETENTION_DAYS=30

# --- Machine learning -------------------------------------------------------
ML_ENABLED=true
ML_URL=http://127.0.0.1:3003
ML_CLIP_MODEL=clip-ViT-B-32
ML_FACE_MODEL=yunet+sface
ML_FACE_MIN_SCORE=0.7
# Cosine distance threshold used when clustering faces into people.
ML_FACE_CLUSTER_DISTANCE=0.5

# --- Video transcoding ------------------------------------------------------
FFMPEG_CRF=23
FFMPEG_PRESET=veryfast
FFMPEG_TARGET_RESOLUTION=720
FFMPEG_ACCEL=disabled
