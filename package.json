{
  "name": "imadeo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted photo and video backup, organization and sharing",
  "workspaces": [
    "server",
    "app",
    "mobile"
  ],
  "scripts": {
    "dev": "yarn infra:up && concurrently -n server,web -c cyan,magenta \"yarn dev:server\" \"yarn dev:app\"",
    "dev:server": "yarn workspace @imadeo/server dev",
    "dev:app": "yarn workspace @imadeo/app dev",
    "build": "yarn workspace @imadeo/server build && yarn workspace @imadeo/app build",
    "start": "yarn workspace @imadeo/server start",
    "infra:up": "docker compose up -d database redis",
    "infra:down": "docker compose stop database redis",
    "watchdog": "bash scripts/dev-watchdog.sh",
    "watchdog:stop": "bash -c 'mkdir -p .dev && touch .dev/watchdog.stop'",
    "db:migrate": "yarn workspace @imadeo/server db:migrate",
    "db:migrate:dev": "yarn workspace @imadeo/server db:migrate:dev",
    "db:generate": "yarn workspace @imadeo/server db:generate",
    "db:seed": "yarn workspace @imadeo/server db:seed",
    "db:studio": "yarn workspace @imadeo/server db:studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint": "yarn workspaces foreach -A run lint",
    "test": "yarn workspaces foreach -A run test",
    "dev:mobile": "yarn workspace @imadeo/mobile start",
    "dev:android": "yarn workspace @imadeo/mobile android",
    "dev:ios": "yarn workspace @imadeo/mobile ios",
    "release:ios": "yarn workspace @imadeo/mobile release:ios"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.0"
}
